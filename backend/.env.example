# ==============================================================================
# NepseRadar - Backend Security Configuration
# ==============================================================================

# Optional: Set an API Secret Key to secure your endpoints against unauthorized public access.
# Leave empty for local development, or set a secure random string in production (e.g. openssl rand -hex 16)
API_KEY=

# Server Network Settings
HOST=0.0.0.0
PORT=8000

# Polling Interval (in minutes) during trading hours
REFRESH_INTERVAL_MINUTES=10

# Rate Limiting
RATE_LIMIT_PER_MINUTE=120
REFRESH_COOLDOWN_SECONDS=30
